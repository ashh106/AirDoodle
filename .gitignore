# ==============================================================================
# AirDoodle .gitignore
# Excludes local environments, build artifacts, temporary caches, and local data
# ==============================================================================

# Node.js dependencies and bundles
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Python environments and byte-code
venv/
.venv/
*_env/
airtype_env/
__pycache__/
*.py[cod]
*$py.class
*.so

# C++ Build outputs & binaries
bin/
build/
*.exe
*.out
*.app
*.o
*.obj
*.dll
*.dylib
*.a
*.lib
cpp-engine/build/
cpp-engine/bin/

# Environment and sensitive secrets
.env
.env.local
.env.*.local
!.env.example

# Local runtime database and generated user data
air-doodle-frontend/server/data/air-doodle-db.json
air-doodle-db.json
*.sqlite
*.db

# Temporary drawings and capture dumps
airtype_drawing.png
airdraw_saves/*.png
*.svg
*.airdoodle.json

# IDE and Editor configurations
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Operating System files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
